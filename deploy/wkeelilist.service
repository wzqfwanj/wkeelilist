[Unit]
Description=wkeeli online services list (wkeeli.cn/lst)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/wkeelilist
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/wkeelilist/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8330 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
